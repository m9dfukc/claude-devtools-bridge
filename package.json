{
    "name": "claude-devtools-bridge",
    "version": "0.4.2",
    "description": "MCP devtools bridge — lets Claude inspect and drive live application state via WebSocket",
    "author": "m9dfukc",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/m9dfukc/claude-devtools-bridge.git"
    },
    "homepage": "https://github.com/m9dfukc/claude-devtools-bridge#readme",
    "bugs": {
        "url": "https://github.com/m9dfukc/claude-devtools-bridge/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.js"
        },
        "./server": {
            "import": "./dist/server/mcp-server.js"
        },
        "./relay": {
            "types": "./dist/relay/ws-relay.d.ts",
            "import": "./dist/relay/ws-relay.js"
        },
        "./adapters/vite": {
            "types": "./dist/adapters/vite.d.ts",
            "import": "./dist/adapters/vite.js"
        },
        "./adapters/node": {
            "types": "./dist/adapters/node.d.ts",
            "import": "./dist/adapters/node.js"
        },
        "./adapters/standalone": {
            "types": "./dist/adapters/standalone.d.ts",
            "import": "./dist/adapters/standalone.js"
        }
    },
    "bin": {
        "devtools-bridge": "./dist/server/cli.js",
        "devtools-server": "./dist/server/mcp-server.js"
    },
    "files": [
        "dist",
        "skills",
        ".claude-plugin",
        ".mcp.json",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "node build.js",
        "typecheck": "tsc -p tsconfig.json",
        "test": "tsx --test test/*.test.ts",
        "devtools": "tsx src/server/mcp-server.ts",
        "prepublishOnly": "yarn typecheck && yarn build && yarn test"
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.27.0",
        "@types/ws": "^8.18.0",
        "esbuild": "^0.25.0",
        "tsx": "^4.19.0",
        "typescript": "^5.8.0",
        "vite": "^6.0.0",
        "zod": "^3.24.0"
    },
    "keywords": [
        "mcp",
        "devtools",
        "claude",
        "state-inspection",
        "debugging"
    ],
    "license": "MIT"
}
